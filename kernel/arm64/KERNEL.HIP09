# Reuse the mature ThunderX2 kernel selection as the benchmarked starting
# point until dedicated HIP09 kernels have architecture-based evidence.
include $(KERNELDIR)/KERNEL.THUNDERX2T99

# The generic SVE swap kernel avoids the inherited ThunderX2 implementation's
# multithreaded regression on HIP09 while remaining within the 1T guardrail.
DSWAPKERNEL = swap.c

# HIP09 implements SVE. Reuse the existing generic SVE GEMV kernels where
# they outperform the inherited ASIMD kernels.
SGEMVNKERNEL = gemv_n_sve_v1x3.c
SGEMVTKERNEL = gemv_t_sve_v1x3.c
DGEMVNKERNEL = gemv_n_sve_v1x3.c
DGEMVTKERNEL = gemv_t_sve_v1x3.c

# The generic ARM64 scalar implementations avoid the inherited ThunderX2
# kernels' internal multithreaded reduction path on HIP09.
SNRM2KERNEL = nrm2.S
DNRM2KERNEL = nrm2.S

# Use the existing SVE symmetric matrix-vector kernels instead of the
# ThunderX2-specific ASIMD selection.
SSYMV_L_KERNEL = symv_L_sve_v1x4.c
SSYMV_U_KERNEL = symv_U_sve_v1x4.c
DSYMV_L_KERNEL = symv_L_sve_v1x4.c
DSYMV_U_KERNEL = symv_U_sve_v1x4.c

# Use the direct SVE kernels for the small beta-zero NN cases where they avoid
# more packing overhead than they add. Other layouts retain the packed GEMM
# path selected by the HIP09 permit function.
SGEMM_SMALL_M_PERMIT = gemm_small_kernel_permit_sve.c
SGEMM_SMALL_K_B0_NN = sgemm_small_kernel_nn_sve.c
DGEMM_SMALL_M_PERMIT = gemm_small_kernel_permit_sve.c
DGEMM_SMALL_K_B0_NN = dgemm_small_kernel_nn_sve.c
